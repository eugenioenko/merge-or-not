 }
+
+function trackClick(target) {
+  if (!target) return
+  for (count = 0; count < target.classList.length; count++) {
+    trackEvent('click', { className: target.classList[count] })
+  }
+}
+
+function trackFormSubmit(form) {
+  const fields = Array.from(form.elements).map((el) => el.name)
+  trackEvent('form_submit', { fields })
+}
