 export function sumAmounts(amounts) {
   return amounts.reduce((total, amount) => total + amount, 0)
 }
+
+export function hasReachedTarget(amounts, target) {
+  return sumAmounts(amounts) === target
+}
+
+export function remainingToTarget(amounts, target) {
+  const remaining = target - sumAmounts(amounts)
+  return remaining > 0 ? remaining : 0
+}
+
+export function formatTotal(amounts) {
+  return `$${sumAmounts(amounts).toFixed(2)}`
+}
