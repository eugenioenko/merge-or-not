@@ -0,0 +1,38 @@
+export class Range {
+  constructor(start, end, step = 1) {
+    if (step === 0) {
+      throw new RangeError('step must not be zero')
+    }
+    this.start = start
+    this.end = end
+    this.step = step
+  }
+
+  [Symbol.iterator]() {
+    let current = this.start
+    const { end, step } = this
+
+    return {
+      next() {
+        const done = step > 0 ? current >= end : current <= end
+        if (done) {
+          return { value: undefined, done: true }
+        }
+        const value = current
+        current += step
+        return { value, done: false }
+      },
+      [Symbol.iterator]() {
+        return this
+      },
+    }
+  }
+
+  toArray() {
+    return [...this]
+  }
+}
+
+export function range(start, end, step) {
+  return new Range(start, end, step)
+}
