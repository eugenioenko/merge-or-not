+++ b/app/services/refund_service.rb
@@ -0,0 +1,18 @@
+class RefundService
+  Result = Struct.new(:success?, :refund_id, :error, keyword_init: true)
+
+  def initialize(order:, amount:)
+    @order = order
+    @amount = amount
+  end
+
+  def call
+    charge = @order.charge
+    refund = PaymentGateway.refund(charge.provider_id, amount: @amount)
+    @order.update!(status: "refunded", refunded_at: Time.current)
+    Result.new(success?: true, refund_id: refund.id)
+  rescue PaymentGateway::Error => e
+    Rails.logger.warn("Refund failed for order #{@order.id}: #{e.message}")
+    Result.new(success?: false, error: e.message)
+  end
+end
