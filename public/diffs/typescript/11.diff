+const cache = new Map<string, UserResponse>();
+
+export async function fetchUser(id: string): Promise<UserResponse> {
+  if (cache.has(id)) {
+    return cache.get(id) as UserResponse;
+  }
+  const res = await fetch(`/api/users/${id}`);
+  const json = await res.json();
+  const user = json as UserResponse;
+  cache.set(id, user);
+  return user;
+}
