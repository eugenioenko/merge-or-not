+declare const brand: unique symbol;
+
+export type UserId = string & { readonly [brand]: "UserId" };
+
+export function createUserId(raw: string): UserId {
+  if (!/^usr_[a-zA-Z0-9]{8,}$/.test(raw)) {
+    throw new Error(`Invalid user id: ${raw}`);
+  }
+  return raw as UserId;
+}
+
+export function getOrderTotal(userId: UserId, orderId: string): number {
+  return lookupOrder(userId, orderId).total;
+}
