+interface ApiError {
+  message: string;
+  code: number;
+}
+
+export function isApiError(value: unknown): value is ApiError {
+  return (
+    typeof value === "object" &&
+    value !== null &&
+    "message" in value &&
+    "code" in value
+  );
+}
+
+export function handleResult(value: unknown): string {
+  if (isApiError(value)) {
+    return `Error ${value.code}: ${value.message}`;
+  }
+  return "OK";
+}
