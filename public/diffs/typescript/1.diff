+export type PaymentEvent =
+  | { id: string; status: "pending"; amount: number }
+  | { id: string; status: "completed"; amount: number }
+  | { id: string; status: "failed"; amount: number; failureReason: string };
+
+function assertUnreachable(value: never): never {
+  throw new Error(`Unhandled payment status: ${JSON.stringify(value)}`);
+}
+
+export function describePayment(event: PaymentEvent): string {
+  switch (event.status) {
+    case "pending":
+      return `Payment ${event.id} is awaiting confirmation`;
+    case "completed":
+      return `Payment ${event.id} for $${event.amount} succeeded`;
+    case "failed":
+      return `Payment ${event.id} failed: ${event.failureReason}`;
+    default:
+      return assertUnreachable(event);
+  }
+}
