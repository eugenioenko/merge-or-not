+
+    pub fn audit_ledger(&self, account_id: u64) -> i64 {
+        let ledger = self.ledger.lock().unwrap();
+        let accounts = self.accounts.lock().unwrap();
+        let ledger_total: i64 = ledger.iter().filter(|e| e.account_id == account_id).map(|e| e.delta).sum();
+        let account_balance = accounts.iter().find(|a| a.id == account_id).map_or(0, |a| a.balance);
+        ledger_total + account_balance
+    }
 }
 
