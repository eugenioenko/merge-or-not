+pub async fn charge_card(
+    gateway: &PaymentGateway,
+    token: &str,
+    amount_cents: u64,
+) -> Result<PaymentResult, PaymentError> {
+    let response = gateway.charge(token, amount_cents).await?;
+    let receipt_id = response
+        .headers()
+        .get("x-receipt-id")
+        .ok_or(PaymentError::MissingReceipt)?
+        .to_str()
+        .map_err(|_| PaymentError::MalformedReceipt)?;
+    Ok(PaymentResult::Success { receipt_id: receipt_id.to_string() })
 }
