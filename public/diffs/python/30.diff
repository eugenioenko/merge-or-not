+import time
 import httpx
 
 from app.config import settings
@@ -5,7 +6,39 @@ from app.config import settings
 _client = httpx.Client(base_url=settings.INVENTORY_SERVICE_URL, timeout=2.0)
 
 
-def get_stock_level(sku):
+class InventoryUnavailable(Exception):
+    pass
+
+
+class CircuitBreaker:
+    def __init__(self, failure_threshold=5, reset_timeout=30):
+        self.failure_threshold = failure_threshold
+        self.reset_timeout = reset_timeout
+        self.failures = 0
+        self.opened_at = None
+
+    def call(self, func, *args, **kwargs):
+        if self.opened_at and time.monotonic() - self.opened_at < self.reset_timeout:
+            raise InventoryUnavailable("circuit open")
+        try:
+            result = func(*args, **kwargs)
+        except Exception:
+            self.failures += 1
+            if self.failures >= self.failure_threshold:
+                self.opened_at = time.monotonic()
+            raise
+        self.failures, self.opened_at = 0, None
+        return result
+
+
+_breaker = CircuitBreaker()
+
+
+def _fetch_stock(sku):
     response = _client.get(f"/stock/{sku}")
     response.raise_for_status()
     return response.json()["quantity"]
+
+
+def get_stock_level(sku):
+    return _breaker.call(_fetch_stock, sku)
