+func (c *GeocodeClient) Lookup(ctx context.Context, address string) (*Coordinates, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, c.baseURL+"/geocode?address="+url.QueryEscape(address), nil)
+	if err != nil {
+		return nil, err
+	}
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+
+	var coords Coordinates
+	if err := json.NewDecoder(resp.Body).Decode(&coords); err != nil {
+		return nil, err
+	}
+	return &coords, nil
+}
