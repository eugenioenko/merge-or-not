 func NewWatcher(ch <-chan Event) *Watcher {
 	return &Watcher{ch: ch}
 }
+
+func (w *Watcher) Watch(ctx context.Context) {
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case evt := <-w.ch:
+			w.handle(evt)
+		case <-time.After(30 * time.Second):
+			log.Println("no events received in 30s")
+		}
+	}
+}
