+import (
+	"context"
+	"sync"
+)
+
+type Pool struct {
+	size int
+	sem  chan struct{}
+	wg   sync.WaitGroup
+}
+
+func (p *Pool) Submit(ctx context.Context, task Task) error {
+	select {
+	case p.sem <- struct{}{}:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+
+	p.wg.Add(1)
+	go func() {
+		defer p.wg.Done()
+		defer func() { <-p.sem }()
+		task.Run()
+	}()
+	return nil
+}
+
+func (p *Pool) Wait() {
+	p.wg.Wait()
+}
