+const { withFilter } = require('graphql-subscriptions');
+const { AuthenticationError } = require('../errors');
+
 const Subscription = {
   commentAdded: {
-    subscribe: (_parent, _args, { pubsub }) => pubsub.asyncIterator('COMMENT_ADDED'),
+    subscribe: withFilter(
+      (_parent, { postId }, { pubsub, currentUser }) => {
+        if (!currentUser) {
+          throw new AuthenticationError('Not authenticated');
+        }
+        return pubsub.asyncIterator('COMMENT_ADDED');
+      },
+      async (payload, { postId }, { db, currentUser }) => {
+        if (payload.commentAdded.postId !== postId) {
+          return false;
+        }
+        const membership = await db.postMember.findFirst({
+          where: { postId, userId: currentUser.id },
+        });
+        return Boolean(membership);
+      },
+    ),
   },
 };
 
