 const axios = require('axios');
+const CircuitBreaker = require('opossum');
 
-async function charge(payload) {
+async function chargeRequest(payload) {
   const response = await axios.post('https://payments.example.com/v1/charge', payload, {
     timeout: 5000,
   });
   return response.data;
 }
 
+const breaker = new CircuitBreaker(chargeRequest, {
+  timeout: 6000,
+  errorThresholdPercentage: 50,
+  resetTimeout: 30000,
+});
+
+breaker.fallback(() => {
+  throw new Error('Payment gateway unavailable, please retry shortly');
+});
+
+async function charge(payload) {
+  return breaker.fire(payload);
+}
+
 module.exports = { charge };
